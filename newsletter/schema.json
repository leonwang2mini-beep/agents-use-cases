{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-use-cases.vercel.app/newsletter/schema.json",
  "title": "Agents Use Cases weekly newsletter issue",
  "type": "object",
  "required": ["id", "week", "subject", "preheader", "status", "publishedAt", "sections", "cta"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$",
      "description": "ISO week id, e.g. 2026-W42"
    },
    "week": {
      "type": "string",
      "description": "Human week label, e.g. Week of 2026-10-19"
    },
    "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
    "preheader": { "type": "string", "minLength": 1, "maxLength": 300 },
    "status": {
      "type": "string",
      "enum": ["draft", "ready", "published", "cancelled"]
    },
    "publishedAt": {
      "type": ["string", "null"],
      "description": "ISO 8601 timestamp when sent; null while draft"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "title", "body"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["intro", "catalog", "ranking", "ops", "featured", "cta", "note"]
          },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "toolIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "useCaseIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "urls": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "cta": {
      "type": "object",
      "required": ["label", "url"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
